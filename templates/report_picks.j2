{%- endif %}
{%- for k in picks %}
{%- set detail = [] %}
{%- if k.thesis %}{% set _ = detail.append('- **推荐逻辑**：' ~ k.thesis) %}
{%- elif k.reason %}{% set _ = detail.append('- **推荐逻辑**：' ~ k.reason) %}{% endif %}
{%- if k.catalysts %}{% set _ = detail.append('- **催化因素**：' ~ k.catalysts|join('；')) %}{% endif %}
{%- set tech = [] %}
{%- if k.ma_bullish %}{% set _ = tech.append('均线多头') %}{% endif %}
{%- if k.above_ma20 %}{% set _ = tech.append('站上MA20') %}{% endif %}
{%- if k.volume_ratio %}{% set _ = tech.append('量比 ' ~ k.volume_ratio) %}{% endif %}
{%- if k.change_60d is not none %}{% set _ = tech.append('近60日 ' ~ ('%+.1f'|format(k.change_60d)) ~ '%') %}{% endif %}
{%- if tech %}{% set _ = detail.append('- **技术状态**：' ~ tech|join(' ｜ ')) %}{% endif %}
{%- set risks = k.risks or k.risk_flags %}
{%- if risks %}{% set _ = detail.append('- **风险提示**：' ~ risks|join('；')) %}
{%- elif k.risk %}{% set _ = detail.append('- **风险提示**：' ~ k.risk) %}{% endif %}
{%- if k.invalidators %}{% set _ = detail.append('- **逻辑失效条件**：' ~ k.invalidators|join('；')) %}{% endif %}
{%- if k.watch_items %}{% set _ = detail.append('- **后续重点看**：' ~ k.watch_items|join('；')) %}{% endif %}
{%- if k.stop_ref %}{% set _ = detail.append('- **参考止损**：跌破 ' ~ k.stop_ref ~ ' 元（按 1.5 倍 20 日 ATR 推算，仅为风控参考）') %}{% endif %}

### {{ num_emoji[loop.index0] if loop.index0 < 10 else loop.index }} {{ k.name }} {{ k.code }}{% if k.score is not none %} ｜ 综合分 {{ k.score }}{% endif %}

