{# 每日「股票推荐」栏目（全市场选股结果） #}
{%- set p = picks_payload or {} -%}
{%- set picks = p.get('picks') or [] -%}
{%- set num_emoji = ['1️⃣','2️⃣','3️⃣','4️⃣','5️⃣','6️⃣','7️⃣','8️⃣','9️⃣','🔟'] -%}
{%- set lines = [] -%}
{%- for k in picks -%}
{%- set bits = [] -%}
{%- if k.price %}{% set _ = bits.append('现价 **' ~ k.price ~ '** 元') %}{% endif -%}
{%- if k.change_pct is not none %}{% set _ = bits.append('（' ~ ('%+.2f'|format(k.change_pct)) ~ '%）') %}{% endif -%}
{%- if k.turnover_rate %}{% set _ = bits.append(' ｜ 换手 ' ~ k.turnover_rate ~ '%') %}{% endif -%}
{%- if k.industry %}{% set _ = bits.append(' ｜ ' ~ k.industry) %}{% endif -%}
{%- set _ = lines.append('**' ~ (num_emoji[loop.index0] if loop.index0 < 10 else loop.index) ~ ' ' ~ k.name ~ '（' ~ k.code ~ '）** ' ~ (bits|join(''))) -%}
{%- endfor -%}
## 🎯 今日推荐（全市场选股）

> 策略：**{{ p.get('strategy_display') or p.get('strategy') }}** ｜ 全市场快照 {{ p.get('snapshot_count') or 0 }} 只 → 硬性条件筛后 {{ p.get('after_filter_count') or 0 }} 只 → 入选 **{{ picks|length }}** 只
