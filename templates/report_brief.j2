{# 自选股简报模板（用户定制：结论先行 + 说明依据 + 明确价位 + 不显示数据来源） #}
{%- macro clip(s, n) -%}
{{- s|string|replace('风险点1：','')|replace('风险点2：','')|replace('风险点3：','')|replace('风险点4：','')|replace('利好1：','')|replace('利好2：','')|replace('利好3：','')|replace('利空1：','')|replace('利空2：','')|replace('利好：','')|replace('风险：','')|replace('技术风险：','')|replace('估值风险：','')|replace('量能风险：','')|replace('技术面：','')|replace('估值面：','')|trim|truncate(n, true, '…')|replace('但…','…')|replace('且…','…')|replace('而…','…')|replace('，…','…')|replace('、…','…')|replace('：…','…')|replace('（…','…')|replace('；…','…') -}}
{%- endmacro -%}
{%- set num_emoji = ['1️⃣','2️⃣','3️⃣','4️⃣','5️⃣','6️⃣','7️⃣','8️⃣','9️⃣','🔟'] -%}
{%- set missing_kw = ['缺失', '无法判断', '为空', 'N/A', '暂无', '不可得', '未披露'] -%}
{%- set summary_lines = [] -%}
{%- for e in enriched -%}
{%- set dash0 = e.result.dashboard or {} -%}
{%- set core0 = dash0.get('core_conclusion') or {} -%}
{%- set one0 = core0.get('one_sentence') or e.result.analysis_summary or e.localized_trend_prediction or '暂无判断' -%}
{%- set _ = summary_lines.append('- **' ~ e.stock_name ~ '** ' ~ e.signal_emoji ~ ' ' ~ e.signal_text ~ '：' ~ one0|truncate(42, true, '…')) -%}
{%- endfor -%}
# 📈 自选股简报（{{ report_date }}{{ ' ' ~ mode_label if mode_label else '' }}）

> {{ results|length }} 只自选股 ｜ 🟢 买入 {{ buy_count }} · 🟡 观望 {{ hold_count }} · 🔴 减仓 {{ sell_count }}
{%- if market_status_line %}
> {{ market_status_line }}
{%- endif %}
> {{ data_baseline_line or ('📊 数据基准：**' ~ report_date ~ ' 收盘（当日完整数据）**') }}
{%- if data_integrity_line %}
> {{ data_integrity_line }}
{%- endif %}

---

{%- if holdings_board or (opportunities and opportunities.actionable) %}

## 🎯 操作信号（今天做什么）

{%- if holdings_board %}

**💼 你的持仓（{{ holdings_board|length }} 只）**
{%- for h in holdings_board %}
- **{{ h.name }} {{ h.code }}**　成本 **{{ h.cost }}** → 现价 **{{ h.price }}**{% if h.pnl_pct is not none %}（**{{ '%+.2f'|format(h.pnl_pct) }}%**）{% endif %}　成交额 **{{ h.amount or 'N/A' }}**

  - **接下来**：{{ h.next_action }}
  - **补仓**：{{ h.add_state }}{% if h.add_reason %} —— {{ h.add_reason }}{% endif %}
  - **做T**：{{ h.t_verdict }}{% if h.t_line %} —— {{ h.t_line }}{% elif h.t_reason %} —— {{ h.t_reason }}{% endif %}
{%- endfor %}
{%- endif %}

{%- set groups = [
    ('🟢 可买入', '🟢 现在就能买'),
    ('🟡 等触发', '🟡 等到价位就能买')
] -%}
{%- if opportunities and opportunities.actionable -%}
{%- for key, title in groups -%}
{%- set items = opportunities.actionable | rejectattr('held') | selectattr('action', 'equalto', key) | list -%}
{%- if items %}

**{{ title }}（{{ items|length }} 只）**
{%- for r in items %}
- **{{ r.name }} {{ r.code }}**　{{ r.price }} 元{% if r.pct_chg is not none %}（{{ '%+.2f'|format(r.pct_chg) }}%）{% endif %}　{% if r.action in ('🟡 等触发',) %}**{{ r.level }} 即为买点**{% if r.gap_pct is not none %}（距现价 {{ '%+.1f'|format(r.gap_pct) }}%）{% endif %}{% else %}买点 **{{ r.level }}**{% endif %}{% if r.stop %}　｜ 止损 **{{ r.stop }}**{% endif %}

  - {{ r.reason }}
{%- endfor %}

{%- endif -%}
{%- endfor -%}
{%- endif -%}
{%- if opportunities and opportunities.none_names %}

**⚪ 暂无信号（{{ opportunities.none_names|length }} 只）**：{{ opportunities.none_names|join('、') }}——形态未满足条件，今天不用动。
{%- endif %}

> ⚠️ 做T前提：当日振幅 ≥ 2.5%（否则价差被手续费和滑点吃掉）；**破位单边下跌时做T会越做越低，涨停单边上涨时卖出容易接不回来**，这两种情况会直接劝阻。补仓铁律：**已跌破支撑位的票不补**。

---

{%- endif %}

## {{ action_heading or '先说人话：接下来怎么办' }}

{{ summary_lines|join('\n') }}

