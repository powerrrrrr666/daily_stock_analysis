{%- for e in enriched -%}
{%- set dash0 = e.result.dashboard or {} -%}
{%- set core0 = dash0.get('core_conclusion') or {} -%}
{%- set one0 = core0.get('one_sentence') or e.result.analysis_summary or e.localized_trend_prediction or '暂无判断' -%}
{%- set _ = summary_lines.append('- **' ~ e.stock_name ~ '** ' ~ e.signal_emoji ~ ' ' ~ e.signal_text ~ '：' ~ one0|truncate(42, true, '…')) -%}
{%- endfor -%}
