{%- for e in enriched %}
{%- set result = e.result %}
{%- set dash = result.dashboard or {} %}
{%- set core = dash.get('core_conclusion') or {} %}
{%- set intel = dash.get('intelligence') or {} %}
{%- set data_persp = dash.get('data_perspective') or {} %}
{%- set battle = dash.get('battle_plan') or {} %}
{%- set sniper = battle.get('sniper_points') or {} %}
{%- set pos_advice = core.get('position_advice') or {} %}
{%- set snap = result.market_snapshot or {} %}
{%- set pp = data_persp.get('price_position') or {} %}
{%- set va = data_persp.get('volume_analysis') or {} %}
{%- set ts = data_persp.get('trend_status') or {} %}
{%- set attr = dash.get('signal_attribution') or {} %}
{%- set price = snap.get('price') or pp.get('current_price') %}
{%- set tech = [] %}
{%- if ts.get('ma_alignment') %}{% set _ = tech.append('均线' ~ ts.get('ma_alignment')) %}{% endif %}
{%- if pp.get('support_level') %}{% set _ = tech.append('支撑 ' ~ pp.get('support_level')) %}{% endif %}
{%- if pp.get('resistance_level') %}{% set _ = tech.append('压力 ' ~ pp.get('resistance_level')) %}{% endif %}
{%- if pp.get('bias_ma5') and pp.get('bias_ma5') != 'N/A' %}{% set _ = tech.append('乖离 ' ~ pp.get('bias_ma5') ~ '%') %}{% endif %}
{%- set bullets = [] %}
{%- if tech %}{% set _ = bullets.append('- **技术面**：' ~ tech|join(' ｜ ')) %}{% endif %}
{%- if va.get('volume_meaning') %}{% set _ = bullets.append('- **量能**：换手 ' ~ (va.get('turnover_rate') or 'N/A') ~ '%，' ~ va.get('volume_meaning')) %}{% endif %}
{%- if intel.get('positive_catalysts') %}{% set _ = bullets.append('- **利好**：' ~ intel.get('positive_catalysts')[:2]|join('；')) %}{% endif %}
{%- if intel.get('risk_alerts') %}{% set _ = bullets.append('- **风险**：' ~ intel.get('risk_alerts')[:2]|join('；')) %}{% endif %}
{%- if intel.get('earnings_outlook') %}{% set _ = bullets.append('- **业绩**：' ~ intel.get('earnings_outlook')) %}{% endif %}
{%- set duo = [] %}
{%- if attr.get('strongest_bullish_signal') %}{% set _ = duo.append('看多「' ~ attr.get('strongest_bullish_signal') ~ '」') %}{% endif %}
{%- if attr.get('strongest_bearish_signal') %}{% set _ = duo.append('看空「' ~ attr.get('strongest_bearish_signal') ~ '」') %}{% endif %}
{%- if duo %}{% set _ = bullets.append('- **多空**：' ~ duo|join('　')) %}{% endif %}

