{%- for e in enriched %}
{%- set result = e.result %}
{%- set dash = result.dashboard or {} %}
{%- set core = dash.get('core_conclusion') or {} %}
{%- set intel = dash.get('intelligence') or {} %}
{%- set data_persp = dash.get('data_perspective') or {} %}
{%- set battle = dash.get('battle_plan') or {} %}
{%- set sniper = battle.get('sniper_points') or {} %}
{%- set pos_advice = core.get('position_advice') or {} %}
{%- set snap = result.market_snapshot or {} %}
{%- set pp = data_persp.get('price_position') or {} %}
{%- set va = data_persp.get('volume_analysis') or {} %}
{%- set ts = data_persp.get('trend_status') or {} %}
{%- set attr = dash.get('signal_attribution') or {} %}
{%- set price = snap.get('price') or pp.get('current_price') %}
{%- set tech = [] %}
{%- if ts.get('ma_alignment') %}{% set _ = tech.append(clip(ts.get('ma_alignment'), 30)) %}{% endif %}
{%- if pp.get('support_level') %}{% set _ = tech.append('支撑 ' ~ pp.get('support_level')) %}{% endif %}
{%- if pp.get('resistance_level') %}{% set _ = tech.append('压力 ' ~ pp.get('resistance_level')) %}{% endif %}
{%- set bullets = [] %}
{%- if tech %}{% set _ = bullets.append('- **技术面**：' ~ tech|join(' ｜ ')) %}{% endif %}
{%- if va.get('volume_meaning') %}{% set _ = bullets.append('- **量能**：换手 ' ~ (va.get('turnover_rate') or 'N/A') ~ '%，' ~ clip(va.get('volume_meaning'), 32)) %}{% elif va.get('turnover_rate') %}{% set _ = bullets.append('- **量能**：换手率 ' ~ va.get('turnover_rate') ~ '%') %}{% endif %}
{%- set pos_items = [] %}
{%- for c in (intel.get('positive_catalysts') or [])[:2] %}{% set _ = pos_items.append(clip(c, 30)) %}{% endfor %}
{%- if pos_items %}{% set _ = bullets.append('- **利好**：' ~ pos_items|join('；')) %}{% endif %}
{%- set risk_items = [] %}
{%- for a in (intel.get('risk_alerts') or [])[:2] %}{% set _ = risk_items.append(clip(a, 30)) %}{% endfor %}
{%- if risk_items %}{% set _ = bullets.append('- **风险**：' ~ risk_items|join('；')) %}{% endif %}
{%- set earn = intel.get('earnings_outlook') %}
{%- set ns = namespace(earn_missing=false) %}
{%- if earn %}{% for kw in missing_kw %}{% if kw in earn %}{% set ns.earn_missing = true %}{% endif %}{% endfor %}{% endif %}
{%- if earn and not ns.earn_missing %}{% set _ = bullets.append('- **业绩**：' ~ clip(earn, 34)) %}{% endif %}
{%- set duo = [] %}
{%- if attr.get('strongest_bullish_signal') %}{% set _ = duo.append('看多「' ~ clip(attr.get('strongest_bullish_signal'), 22) ~ '」') %}{% endif %}
{%- if attr.get('strongest_bearish_signal') %}{% set _ = duo.append('看空「' ~ clip(attr.get('strongest_bearish_signal'), 22) ~ '」') %}{% endif %}
{%- if duo %}{% set _ = bullets.append('- **多空**：' ~ duo|join('　')) %}{% endif %}

