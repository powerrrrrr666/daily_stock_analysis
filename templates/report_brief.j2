{# 自选股简报模板（用户定制：结论先行 + 说明依据 + 明确价位 + 不显示数据来源） #}
{%- macro clip(s, n) -%}
{{- s|string|replace('风险点1：','')|replace('风险点2：','')|replace('风险点3：','')|replace('风险点4：','')|replace('利好1：','')|replace('利好2：','')|replace('利好3：','')|replace('利空1：','')|replace('利空2：','')|replace('利好：','')|replace('风险：','')|replace('技术风险：','')|replace('估值风险：','')|replace('量能风险：','')|replace('技术面：','')|replace('估值面：','')|trim|truncate(n, true, '…')|replace('但…','…')|replace('且…','…')|replace('而…','…')|replace('，…','…')|replace('、…','…')|replace('：…','…')|replace('（…','…')|replace('；…','…') -}}
{%- endmacro -%}
{%- set num_emoji = ['1️⃣','2️⃣','3️⃣','4️⃣','5️⃣','6️⃣','7️⃣','8️⃣','9️⃣','🔟'] -%}
{%- set missing_kw = ['缺失', '无法判断', '为空', 'N/A', '暂无', '不可得', '未披露'] -%}
{%- set summary_lines = [] -%}
{%- for e in enriched -%}
{%- set dash0 = e.result.dashboard or {} -%}
{%- set core0 = dash0.get('core_conclusion') or {} -%}
{%- set one0 = core0.get('one_sentence') or e.result.analysis_summary or e.localized_trend_prediction or '暂无判断' -%}
{%- set _ = summary_lines.append('- **' ~ e.stock_name ~ '** ' ~ e.signal_emoji ~ ' ' ~ e.signal_text ~ '：' ~ one0|truncate(42, true, '…')) -%}
{%- endfor -%}
# 📈 自选股简报（{{ report_date }}）

> {{ results|length }} 只自选股 ｜ 🟢 买入 {{ buy_count }} · 🟡 观望 {{ hold_count }} · 🔴 减仓 {{ sell_count }}
