{%- if sniper.get('stop_loss') %}{% set _ = levels.append('止损 ' ~ clip(clean_sniper(sniper.get('stop_loss')), 22)) %}{% endif %}
{%- if sniper.get('take_profit') %}{% set _ = levels.append('目标 ' ~ clip(clean_sniper(sniper.get('take_profit')), 22)) %}{% endif %}
